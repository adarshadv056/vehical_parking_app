# Vehicle Parking App - Environment Template
# Copy to .env and fill in secrets. NEVER commit .env to git.

# ──────────────────────────────────────────────────────────────────────────
# Core Flask / JWT
# ──────────────────────────────────────────────────────────────────────────
FLASK_ENV=production
FLASK_DEBUG=0
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_TOKEN_HOURS=24

# ──────────────────────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────────────────────
# Postgres (production)
DB_PASSWORD=strong-postgres-password
# The compose file expands this into:
#   DATABASE_URL=postgresql+psycopg://parking:${DB_PASSWORD}@db:5432/parking
# For local SQLite dev, leave empty (defaults to sqlite:///parking.db in instance/)

# ──────────────────────────────────────────────────────────────────────────
# Redis / Celery
# ──────────────────────────────────────────────────────────────────────────
# In Docker compose: redis://redis:6379/0
# For local dev without Redis: leave empty -> falls back to SimpleCache / inline tasks
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ──────────────────────────────────────────────────────────────────────────
# Admin seeding (runs once on first deploy if table empty)
# ──────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@gmail
ADMIN_PASSWORD=change-this-password
ADMIN_USERNAME=Admin
SEED_ADMIN=1

# ──────────────────────────────────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the API
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ──────────────────────────────────────────────────────────────────────────
# SMTP (optional - emails won't send without this, but app won't crash)
# ──────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_STARTTLS=true
SENDER_EMAIL=your_email@gmail.com

# ──────────────────────────────────────────────────────────────────────────
# Google Chat webhook for daily reminders (optional)
# ──────────────────────────────────────────────────────────────────────────
# Get this from Google Chat space -> Configure webhooks
CHAT_WEBHOOK_URL=

# ──────────────────────────────────────────────────────────────────────────
# Frontend (Vite/Vue CLI)
# ──────────────────────────────────────────────────────────────────────────
# Set this in the frontend .env or your hosting platform
VUE_APP_API_BASE=http://localhost:5000